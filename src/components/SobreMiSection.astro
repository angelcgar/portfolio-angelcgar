---
import translations from '../i18n/sobreMi.json';

interface Props {
  lang: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = translations[lang];
---

<section id="sobre-mi" class="py-20 dark:bg-dark">
  <div class="container px-4 mx-auto">
    <h2 class="mb-12 text-3xl font-bold text-center">
      {t.title} <span class="text-accent">{t.titleAccent}</span>
    </h2>

    <div class="max-w-3xl p-8 mx-auto rounded-lg shadow-md">
      <p
        class="text-body mb-4 leading-relaxed text-balance"
      >
        {t.paragraph1}
      </p>
      <p
        class="text-body mb-4 leading-relaxed text-balance"
      >
        {t.paragraph2}
      </p>
      <p
        class="text-body mb-4 leading-relaxed text-balance"
      >
        {t.paragraph3}
      </p>
      <p class="text-body leading-relaxed text-balance">
        {t.paragraph4}
      </p>
    </div>
  </div>
</section>
